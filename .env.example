# Server listen address
HTTP_ADDR=:8080

# Required — include database name in the path
MONGODB_URI=mongodb://localhost:27017/home_essentials
# Atlas example:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/home_essentials?retryWrites=true&w=majority

# Comma-separated browser origins (client + admin). Update for production domains.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Required for admin login
JWT_SECRET=change-me-to-a-long-random-string

# Supabase Storage (leave blank until ready — uploads return 503)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# Paystack (leave blank until ready — payments return 503)
PAYSTACK_SECRET_KEY=
CLIENT_PUBLIC_URL=http://localhost:3000
# Optional override; defaults to {CLIENT_PUBLIC_URL}/store
# PAYSTACK_CALLBACK_URL=http://localhost:3000/store

# SMTP (leave blank until emails are needed)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_NOTIFY_EMAIL=

# Optional JSON log file
# APP_LOG_FILE=app.log
